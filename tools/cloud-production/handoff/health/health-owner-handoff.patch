@@ -0,0 +1,74 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import {fileURLToPath} from 'node:url';
+const here=path.dirname(fileURLToPath(import.meta.url));
+const read=file=>{try{return JSON.parse(fs.readFileSync(file,'utf8'));}catch{return null;}};
+const iso=value=>typeof value==='string'&&Number.isFinite(Date.parse(value))?new Date(value).toISOString():null;
+const sha=value=>typeof value==='string'&&/^[a-f0-9]{40}$/i.test(value);
+const digest=value=>typeof value==='string'&&/^[a-f0-9]{64}$/i.test(value);
+export const SOPILOT_REPOSITORY='acaiaishizhan/rss-ingest-action';
+export const SOPILOT_WORKFLOW='sopilot-producer.yml';
+export const SOPILOT_SOURCE_SHA256='1c5577a96731a3539285e98e6e689d8f10ee39b7edbf409eff4ddbd8ae123b66';
+export function sopilotOwner(dataDir=path.join(here,'.data')){
+  const config=read(path.join(dataDir,'producer-monitor-config.json'));
+  if(!config||Array.isArray(config)||typeof config!=='object')return {owner:'invalid'};
+  if(!config.sopilot?.owner){
+    const cache=read(path.join(dataDir,'sopilot-cloud-receipts.json'));
+    return {owner:cache?.schema_version===1?'invalid':'local'};
+  }
+  const lane=config.sopilot;
+  return {owner:lane.owner==='cloud'?'cloud':lane.owner==='local'?'local':'invalid',activated_at:iso(lane.activated_at),workflow:lane.workflow};
+}
+export function localSopilotAllowed(owner=sopilotOwner()){return owner.owner==='local';}
+export function verifySopilotReceipt(receipt,run,owner){
+  if(receipt?.schema_version!==1||receipt.owner!=='cloud'||receipt.mode!=='production'||receipt.source!=='sopilot'||receipt.workflow!==SOPILOT_WORKFLOW)return false;
+  if(!owner.activated_at||owner.workflow!==SOPILOT_WORKFLOW||run?.status!=='completed'||run.conclusion!=='success')return false;
+  const r=receipt.run,c=receipt.capture,p=receipt.publish;
+  if(r?.repository!==SOPILOT_REPOSITORY||String(r.id)!==String(run.databaseId)||Number(r.attempt)!==Number(run.attempt)||r.code_sha!==run.headSha||!sha(r.code_sha)||r.url!==run.url)return false;
+  if(c?.status!=='success'||!iso(c.started_at)||!iso(c.finished_at)||Date.parse(c.started_at)<Date.parse(owner.activated_at)||Date.parse(c.finished_at)<Date.parse(c.started_at))return false;
+  if(!['entries','discovered','prefiltered'].every(k=>Number.isInteger(c[k])&&c[k]>=0)||!Array.isArray(c.pages)||c.pages.length===0||c.source_sha256!==SOPILOT_SOURCE_SHA256||!digest(c.rss_sha256)||c.discovered!==c.prefiltered+c.entries)return false;
+  for(const category of ['AI','Creator']){
+    const pages=c.pages.filter(page=>page.category===category),total=pages[0]?.totalPages;
+    if(!Number.isInteger(total)||total<1||pages.length!==total)return false;
+    for(let page=1;page<=total;page++)if(!pages.some(row=>row.page===page&&row.http_success===true&&row.parse_success===true&&row.http_status>=200&&row.http_status<300&&row.totalPages===total&&digest(row.sha256)))return false;
+  }
+  if(!['confirmed','unchanged'].includes(p?.status)||p.target!=='feeds/sopilot.xml'||p.target_blob_verified!==true||!sha(p.remote_sha)||!sha(p.target_blob)||!iso(p.started_at)||!iso(p.finished_at)||Date.parse(p.finished_at)<Date.parse(c.finished_at)||Date.parse(p.finished_at)<Date.parse(p.started_at))return false;
+  return true;
+}
+export function sopilotCloudSnapshot({dataDir=path.join(here,'.data'),now=Date.now(),owner=sopilotOwner(dataDir),cache=read(path.join(dataDir,'sopilot-cloud-receipts.json'))}={}){
+  const rows=(cache?.runs||[]).filter(row=>row.run&&Date.parse(row.run.createdAt)>=Date.parse(owner.activated_at||''));
+  const latest=rows[0],verified=rows.find(row=>verifySopilotReceipt(row.receipt,row.run,owner));
+  const lastSuccess=verified?.receipt.publish.finished_at||null;
+  const base={owner:'cloud',checked_at:iso(cache?.observed_at),last_success_at:lastSuccess,expected_since:owner.activated_at||null,run_id:latest?.run.databaseId||null,run_url:latest?.run.url||null};
+  if(owner.owner!=='cloud'||!owner.activated_at||owner.workflow!==SOPILOT_WORKFLOW)return {...base,status:'unknown',error:'SoPilot cloud owner configuration is incomplete'};
+  if(!latest)return {...base,status:'unknown',error:'No production cloud capture and publish receipt since owner activation'};
+  if(latest.run.status!=='completed')return {...base,status:'pending'};
+  if(verifySopilotReceipt(latest.receipt,latest.run,owner))return {...base,status:'completed',finished_at:latest.receipt.publish.finished_at,receipt_verified:true,entries:latest.receipt.capture.entries};
+  const failed=latest.run.conclusion!=='success'||['failed','unknown','uncertain'].includes(latest.receipt?.publish?.status)||latest.receipt?.capture?.status==='failed';
+  const consecutive=rows.findIndex(row=>verifySopilotReceipt(row.receipt,row.run,owner));
+  return {...base,status:failed?'needs_attention':'unknown',failure_identity:`cloud:${latest.run.databaseId}:${latest.run.attempt}`,consecutive_failures:failed?(consecutive<0?rows.filter(r=>r.run.status==='completed').length:consecutive):0,error:latest.error||'Production capture/publish receipt failed or is not verified; inspect this original run only'};
+}
+export async function observeSopilotCloud({dataDir,execute,now=Date.now(),owner=sopilotOwner(dataDir)}){
+  if(owner.owner!=='cloud'||!owner.activated_at||owner.workflow!==SOPILOT_WORKFLOW)return sopilotCloudSnapshot({dataDir,now,owner});
+  const result=await execute('gh',['run','list','--repo',SOPILOT_REPOSITORY,'--workflow',SOPILOT_WORKFLOW,'--branch','main','--limit','30','--json','databaseId,status,conclusion,createdAt,updatedAt,url,headSha,attempt']);
+  if(result.code!==0)throw Error('GitHub production observation failed: '+result.stderr.slice(-400));
+  const old=read(path.join(dataDir,'sopilot-cloud-receipts.json'));
+  const runs=JSON.parse(result.stdout).filter(run=>Date.parse(run.createdAt)>=Date.parse(owner.activated_at||'')).map(run=>({run}));
+  for(const row of runs.slice(0,3)){
+    if(row.run.status!=='completed')continue;
+    const saved=old?.runs?.find(x=>x.run.databaseId===row.run.databaseId&&x.run.attempt===row.run.attempt&&x.run.updatedAt===row.run.updatedAt);
+    if(saved?.receipt){row.receipt=saved.receipt;continue;}
+    const directory=fs.mkdtempSync(path.join(dataDir,'sopilot-receipt-'));
+    try{
+      const artifact=`sopilot-production-receipt-${row.run.databaseId}-${row.run.attempt}`;
+      const downloaded=await execute('gh',['run','download',String(row.run.databaseId),'--repo',SOPILOT_REPOSITORY,'--name',artifact,'--dir',directory]);
+      if(downloaded.code!==0)row.error='Production receipt artifact unavailable; inspect original run';
+      else row.receipt=read(path.join(directory,'receipt.json'));
+    }finally{fs.rmSync(directory,{recursive:true,force:true});}
+  }
+  for(const row of runs.slice(3)){const saved=old?.runs?.find(x=>x.run.databaseId===row.run.databaseId&&x.run.attempt===row.run.attempt);if(saved?.receipt)row.receipt=saved.receipt;}
+  const cache={schema_version:1,observed_at:new Date(now).toISOString(),runs};
+  fs.writeFileSync(path.join(dataDir,'sopilot-cloud-receipts.json.new'),JSON.stringify(cache,null,2));
+  fs.renameSync(path.join(dataDir,'sopilot-cloud-receipts.json.new'),path.join(dataDir,'sopilot-cloud-receipts.json'));
+  return sopilotCloudSnapshot({dataDir,now,owner,cache});
+}
